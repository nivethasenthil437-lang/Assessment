{
  "name": "Bonus - Uptime Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] }
      },
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "s1", "name": "url", "value": "https://demo.realworld.io", "type": "string" },
            { "id": "s2", "name": "startedAt", "value": "={{ Date.now() }}", "type": "number" }
          ]
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Set Target",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 200]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "timeout": 10000,
          "response": { "response": { "fullResponse": true, "neverError": true, "responseFormat": "text" } }
        }
      },
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Ping App",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 200],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const t = $('Set Target').first().json;\nconst code = $json.statusCode ?? 0; // 0 = no response (timeout / DNS / connection error)\nconst ms = Date.now() - t.startedAt;\nconst ok = code === 200;\n\n// Running stats for the daily summary (persists only when the workflow is ACTIVE)\nconst s = $getWorkflowStaticData('global');\ns.total = (s.total || 0) + 1;\ns.fail = (s.fail || 0) + (ok ? 0 : 1);\ns.sumMs = (s.sumMs || 0) + ms;\ns.maxMs = Math.max(s.maxMs || 0, ms);\n\nreturn [{ json: { ok, code, ms, url: t.url, checkedAt: new Date().toISOString(), error: $json.error?.message || null } }];"
      },
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "Evaluate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "d1",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "false", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000005",
      "name": "Is Down?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 200]
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "=🚨 APP DOWN: {{ $json.url }} returned {{ $json.code || 'no response' }} ({{ $json.ms }} ms) at {{ $json.checkedAt }}{{ $json.error ? ' — ' + $json.error : '' }}",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000006",
      "name": "Alert Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [1100, 100],
      "credentials": {
        "discordWebhookApi": { "id": "REPLACE_ME", "name": "Discord Webhook" }
      }
    },
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "0 9 * * *" }] }
      },
      "id": "b2000000-0000-4000-8000-000000000007",
      "name": "Daily 9AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 500]
    },
    {
      "parameters": {
        "jsCode": "const s = $getWorkflowStaticData('global');\nconst total = s.total || 0;\nconst fail = s.fail || 0;\nconst avg = total ? Math.round(s.sumMs / total) : 0;\nconst uptime = total ? (((total - fail) / total) * 100).toFixed(2) : 'n/a';\nconst content = `📊 Daily uptime summary\\nChecks: ${total} | Failures: ${fail} | Uptime: ${uptime}%\\nAvg response: ${avg} ms | Slowest: ${s.maxMs || 0} ms`;\n// reset for next day\ns.total = 0; s.fail = 0; s.sumMs = 0; s.maxMs = 0;\nreturn [{ json: { content } }];"
      },
      "id": "b2000000-0000-4000-8000-000000000008",
      "name": "Build Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 500]
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "={{ $json.content }}",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000009",
      "name": "Send Summary",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [440, 500],
      "credentials": {
        "discordWebhookApi": { "id": "REPLACE_ME", "name": "Discord Webhook" }
      }
    }
  ],
  "connections": {
    "Every 5 Minutes": { "main": [[{ "node": "Set Target", "type": "main", "index": 0 }]] },
    "Set Target": { "main": [[{ "node": "Ping App", "type": "main", "index": 0 }]] },
    "Ping App": { "main": [[{ "node": "Evaluate", "type": "main", "index": 0 }]] },
    "Evaluate": { "main": [[{ "node": "Is Down?", "type": "main", "index": 0 }]] },
    "Is Down?": { "main": [[{ "node": "Alert Discord", "type": "main", "index": 0 }], []] },
    "Daily 9AM": { "main": [[{ "node": "Build Summary", "type": "main", "index": 0 }]] },
    "Build Summary": { "main": [[{ "node": "Send Summary", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
